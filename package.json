{
  "name": "decision-echo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --ip 127.0.0.1 --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf:types": "wrangler types",
    "check": "npm run typecheck && npm test && npm run build",
    "test:api": "node tests/api.integration.mjs",
    "test:browser": "node tests/browser.integration.mjs",
    "test:extension": "node apps/chrome-extension/panel.test.mjs",
    "test:extension:worker": "TEST_WORKER=1 node apps/chrome-extension/runtime.test.mjs",
    "test:extension:runtime": "node apps/chrome-extension/runtime.test.mjs",
    "test:voice": "node tests/voice.integration.mjs",
    "test:lease": "node tests/lease.integration.mjs",
    "test:integration": "npm run test:api && npm run test:browser && npm run test:extension && npm run test:extension:runtime",
    "test:vision": "node tests/vision.integration.mjs",
    "test:live-learning": "node tests/live-learning.integration.mjs",
    "test:live-planner": "node tests/live-planner.integration.mjs",
    "test:model-latency": "node tests/model-latency.integration.mjs",
    "deploy": "npm run build && wrangler deploy --var APP_ORIGIN:https://decision-echo.litchis-sixty-1m.workers.dev",
    "test:voice-ui": "node tests/voice-presence.integration.mjs",
    "test:vertex-adapter": "node --test tests/vertex-adapter.test.mjs",
    "test:gemini-luna": "node tests/gemini-luna.integration.mjs"
  },
  "dependencies": {
    "@elevenlabs/react": "1.16.0",
    "hono": "4.13.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
